# ─────────────────────────────────────────────────────────────────────────────
# IC Markets DEMO config. Copy this to `.env`:   copy .env.icmarkets .env
# Open a free demo (MT5 + Raw Spread):  https://www.icmarkets.com/global/en/open-trading-account/demo
# Then fill LOGIN / PASSWORD / SERVER from your welcome email and CONFIRM the
# server name in the MT5 terminal login dialog.
# ─────────────────────────────────────────────────────────────────────────────

# --- IC Markets demo credentials ---
MT5_LOGIN=51234567
MT5_PASSWORD=your-demo-master-password
# Common IC Markets demo servers (CONFIRM yours): ICMarkets-Demo, ICMarketsSC-Demo, ICMarketsEU-Demo
MT5_SERVER=ICMarketsSC-Demo
# Optional: path to terminal64.exe if MT5 isn't auto-detected.
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- Mode / safety (leave as-is) ---
TRADING_MODE=DEMO
I_UNDERSTAND_LIVE_TRADING_RISKS=
KILL_SWITCH=0

# --- Instrument & strategy ---
# IC Markets uses plain EURUSD (CONFIRM in Market Watch; may be EURUSD.a / EURUSD.r).
SYMBOL=EURUSD
TIMEFRAME=M5
RISK_PER_TRADE=0.01
# Hard ceiling: skip a trade if the broker's MINIMUM lot would risk more than this
# fraction of equity. Matters on tiny accounts where 0.01 lot is already a big %.
MAX_RISK_PER_TRADE=0.02
# Risk sizing: 'tiered' scales risk by account size (20% <\$100 ... 1% at \$1k+);
# 'fixed' uses RISK_PER_TRADE above for every balance.
RISK_MODE=tiered
# Broker server time vs UTC. Leave blank to AUTO-detect (recommended).
# Set e.g. 3 or -3 only if the chart's times look offset.
# BROKER_UTC_OFFSET_HOURS=
MAX_DAILY_LOSS=0.03

# --- Strategy tuning (M5 defaults shown; all optional, safe to leave) ---
# EMA crossover: fast must be < slow. 9/21 is the standard M5 baseline.
#   Less noise / fewer trades: try 12/26 or 21/55.  More reactive: 5/13.
EMA_FAST=9
EMA_SLOW=21
# RSI momentum filter (period and overbought/oversold gates).
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
# ATR stop sizing. On M5 the spread is a bigger share of a small ATR, so a
# wider multiple (e.g. 2.0) reduces premature stop-outs; 1.5 is the default.
ATR_PERIOD=14
ATR_MULTIPLIER=1.5
RISK_REWARD=1.5
# How many M5 candles to pull each cycle (warmup + context). 600 = ~50h.
HISTORY_BARS=600
