# -----------------------------------------------------------------------------
# Forex Bot credentials & runtime config. Copy this file to `.env` and fill in.
#   cp .env.example .env
# NEVER commit your real .env (see .gitignore).
# -----------------------------------------------------------------------------

# --- MT5 demo account credentials (from your broker) ---
MT5_LOGIN=12345678
MT5_PASSWORD=your-demo-password
MT5_SERVER=YourBroker-Demo
# Optional: full path to terminal64.exe if MT5 isn't auto-detected.
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- Trading mode ---
# DEMO is the default and only safe value. LIVE is intentionally awkward to enable.
TRADING_MODE=DEMO
# To actually allow LIVE you must ALSO set this to the exact phrase below.
# Leave it empty/unset for normal use.
I_UNDERSTAND_LIVE_TRADING_RISKS=

# --- Kill switch ---
# Set to 1 / true to refuse ALL new orders regardless of signals.
KILL_SWITCH=0

# --- Instrument & strategy ---
# SYMBOL is the PRIMARY/charted instrument. The scanner watches a whole list.
SYMBOL=EURUSD
TIMEFRAME=M5

# --- Multi-symbol scanner ---
# SYMBOLS: comma-separated watchlist the bot ranks every cycle. Leave BLANK to
# use the built-in multi-asset watchlist (FX majors+crosses, gold/silver/oil,
# indices, crypto). The bot auto-skips any your broker doesn't offer. Set to the
# word SINGLE to trade only SYMBOL (old single-pair behaviour).
#   Example: SYMBOLS=EURUSD,GBPUSD,XAUUSD,US30,BTCUSD
SYMBOLS=
# How to act once opportunities are ranked:
#   best  = scan all, trade only the single strongest at a time (1 open position)
#   top_n = allow up to SCAN_TOP_N concurrent positions
#   any   = trade every symbol that fires, up to MAX_OPEN_POSITIONS
SCAN_MODE=best
SCAN_TOP_N=3
# Skip opportunities scoring below this (0..1). 0 = always take the best signal.
# Raising it to ~0.55-0.65 is a quick way to cut weak/whipsaw crosses (the blended
# score includes signal strength, HTF trend, volatility and spread).
SCAN_MIN_SCORE=0.0
# Higher timeframe used to rank trend alignment of each M5 signal.
HTF_TIMEFRAME=M15
# HARD trend gate: when true (recommended), only take an M5 long if the HTF trend
# is UP and a short only if it's DOWN. This is the strongest single whipsaw filter.
# If the HTF trend can't be read, entries are skipped (safe default).
REQUIRE_HTF_ALIGN=true

# --- Risk ---
RISK_PER_TRADE=0.01
# Hard ceiling: skip a trade if the broker's MINIMUM lot would risk more than this
# fraction of equity. Matters on tiny accounts where 0.01 lot is already a big %.
MAX_RISK_PER_TRADE=0.02
# Risk sizing: 'fixed' (default) uses RISK_PER_TRADE above for every balance �
# this is the conservative, documented 1% model. 'tiered' scales risk UP on small
# accounts (up to ~20% <$100, easing to 1% at $1k+); it is validated against hard
# caps at startup but is genuinely aggressive � opt in deliberately.
RISK_MODE=fixed
# Broker server time vs UTC. Leave blank to AUTO-detect (recommended).
# Set e.g. 3 or -3 only if the chart's times look offset.
# BROKER_UTC_OFFSET_HOURS=
MAX_DAILY_LOSS=0.03
# Max simultaneous positions (scan_mode=best forces 1).
MAX_OPEN_POSITIONS=1

# --- Account-level circuit-breakers & exposure (safety on top of the daily stop) ---
# Halt NEW entries if peak->current equity drawdown exceeds this fraction (0 = off).
# This baseline resets when the bot restarts.
MAX_TOTAL_DRAWDOWN=0.15
# Halt NEW entries after this many losing trades in a row (0 = off). Forces a review
# after a bad streak; clears when a later trade wins.
MAX_CONSECUTIVE_LOSSES=6
# Correlation guard: max concurrent positions sharing a currency. 1 = never hold two
# positions on the same currency (e.g. blocks EURUSD + EURGBP). Only bites in
# scan_mode top_n/any. Set higher to allow stacking.
MAX_PER_CURRENCY=1
# Execution refuses a fill if the live spread exceeds this many points (0 = off).
# A cheap guard against entering during news spikes / illiquid hours.
MAX_SPREAD_POINTS=0

# --- Exit management ---
# Once the target is reached, trail the stop by ATR (on top of the break-even move)
# while riding the trend, so a deep reversal gives back less. false = break-even only.
TRAIL_AFTER_TP=true
TRAIL_ATR_MULT=1.5
# Partial take-profit: bank PARTIAL_TP_FRACTION of the position once price reaches
# PARTIAL_TP_R (in R = multiples of the stop distance), then move the remainder to
# break-even and let it ride. Needs a position big enough to split (>= 2x min lot).
PARTIAL_TP_ENABLED=true
PARTIAL_TP_FRACTION=0.5
PARTIAL_TP_R=1.0
# LOCK_PROFIT_R: once the target is reached (or a partial is banked), move the stop
# to LOCK this many R of profit instead of just break-even. 0.8 = keep +0.8R even if
# it reverses, while the trend-ride still lets the rest run. 0 = break-even only.
LOCK_PROFIT_R=0.8
# MAX_BARS_IN_TRADE: force-close a trade that NEVER reached target/partial after this
# many bars (frees capital from trades going nowhere). Riding winners are exempt, so
# this won't cut a runner short. 0 = off. On M5, 96 bars = 8h, 288 = 24h.
MAX_BARS_IN_TRADE=0

# --- Strategy tuning (M5 defaults shown; all optional, safe to leave) ---
# EMA crossover: fast must be < slow. 9/21 is the standard M5 baseline.
EMA_FAST=9
EMA_SLOW=21
# RSI gate. RSI_MODE decides how RSI interacts with the EMA cross:
#   confirm (default, recommended) = RSI must AGREE with the cross: a long needs
#           RSI >= RSI_MIDLINE, a short needs RSI <= RSI_MIDLINE (momentum confirms).
#   filter  = legacy overbought/oversold veto (rarely triggers at a fresh cross).
RSI_PERIOD=14
RSI_MODE=confirm
RSI_MIDLINE=50
# Only used when RSI_MODE=filter:
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
# ATR stop sizing.
ATR_PERIOD=14
ATR_MULTIPLIER=1.5
RISK_REWARD=1.5
# ADX trend-strength gate. When REQUIRE_ADX=true, only OPEN a trade if ADX >= ADX_MIN
# (the market is actually trending). ADX ~20-25 is the usual "trending" threshold.
# Set REQUIRE_ADX=false to disable. This is the strongest filter against range chop.
ADX_PERIOD=14
ADX_MIN=20
REQUIRE_ADX=true

# --- Session filter (UTC) ---
# When true, the bot only OPENS new trades inside the hour window below (it still
# manages/closes open trades any time). Restricting to the liquid London + London/NY
# overlap (~07:00-16:00 UTC for EUR/USD) avoids most thin-hours chop. The window may
# wrap past midnight (e.g. START=22, END=6). Set SESSION_FILTER=false to trade 24h.
SESSION_FILTER=true
SESSION_START_HOUR=7
SESSION_END_HOUR=16

# How many M5 candles to pull each cycle (warmup + context). 600 = ~50h.
HISTORY_BARS=600
