# -----------------------------------------------------------------------------
# Forex Bot credentials & runtime config. Copy this file to `.env` and fill in.
#   cp .env.example .env
# NEVER commit your real .env (see .gitignore).
# -----------------------------------------------------------------------------

# --- MT5 demo account credentials (from your broker) ---
MT5_LOGIN=12345678
MT5_PASSWORD=your-demo-password
MT5_SERVER=YourBroker-Demo
# Optional: full path to terminal64.exe if MT5 isn't auto-detected.
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- Trading mode ---
# DEMO is the default and only safe value. LIVE is intentionally awkward to enable.
TRADING_MODE=DEMO
# To actually allow LIVE you must ALSO set this to the exact phrase below.
# Leave it empty/unset for normal use.
I_UNDERSTAND_LIVE_TRADING_RISKS=

# --- Kill switch ---
# Set to 1 / true to refuse ALL new orders regardless of signals.
KILL_SWITCH=0

# --- Instrument & strategy ---
# SYMBOL is the PRIMARY/charted instrument. The scanner watches a whole list.
SYMBOL=EURUSD
TIMEFRAME=M5

# --- Multi-symbol scanner ---
# SYMBOLS: comma-separated watchlist the bot ranks every cycle. Leave BLANK to
# use the built-in multi-asset watchlist (FX majors+crosses, gold/silver/oil,
# indices, crypto). The bot auto-skips any your broker doesn't offer. Set to the
# word SINGLE to trade only SYMBOL (old single-pair behaviour).
#   Example: SYMBOLS=EURUSD,GBPUSD,XAUUSD,US30,BTCUSD
SYMBOLS=
# How to act once opportunities are ranked:
#   best  = scan all, trade only the single strongest at a time (1 open position)
#   top_n = allow up to SCAN_TOP_N concurrent positions
#   any   = trade every symbol that fires, up to MAX_OPEN_POSITIONS
SCAN_MODE=best
SCAN_TOP_N=3
# Skip opportunities scoring below this (0..1). 0 = always take the best signal.
SCAN_MIN_SCORE=0.0
# Higher timeframe used to rank trend alignment of each M5 signal.
HTF_TIMEFRAME=M15

# --- Risk ---
RISK_PER_TRADE=0.01
# Hard ceiling: skip a trade if the broker's MINIMUM lot would risk more than this
# fraction of equity. Matters on tiny accounts where 0.01 lot is already a big %.
MAX_RISK_PER_TRADE=0.02
# Risk sizing: 'tiered' scales risk by account size (20% <$100 ... 1% at $1k+);
# 'fixed' uses RISK_PER_TRADE above for every balance.
RISK_MODE=tiered
# Broker server time vs UTC. Leave blank to AUTO-detect (recommended).
# Set e.g. 3 or -3 only if the chart's times look offset.
# BROKER_UTC_OFFSET_HOURS=
MAX_DAILY_LOSS=0.03
# Max simultaneous positions (scan_mode=best forces 1).
MAX_OPEN_POSITIONS=1

# --- Strategy tuning (M5 defaults shown; all optional, safe to leave) ---
# EMA crossover: fast must be < slow. 9/21 is the standard M5 baseline.
EMA_FAST=9
EMA_SLOW=21
# RSI momentum filter (period and overbought/oversold gates).
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
# ATR stop sizing.
ATR_PERIOD=14
ATR_MULTIPLIER=1.5
RISK_REWARD=1.5
# How many M5 candles to pull each cycle (warmup + context). 600 = ~50h.
HISTORY_BARS=600
